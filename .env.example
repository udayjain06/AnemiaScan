# Public URL of the deployed Render API. Leave blank for on-device analysis.
VITE_API_URL=https://your-render-service.onrender.com
# Backend only: comma-separated Vercel frontend origins.
ALLOWED_ORIGINS=https://your-app.vercel.app

# Backend only. Never put the service-role key in VITE_* variables or frontend code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret
